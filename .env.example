# Same Clerk application as web/ and apk/. Publishable key only — never put CLERK_SECRET_KEY here.
# Packaged builds load orrbit://renderer — add that origin on this Clerk instance (see README).
VITE_CLERK_PUBLISHABLE_KEY=

# Product identity used for the window title, dock/installer name, bundle id, and About.
# Same pattern as the APK `EXPO_PUBLIC_APP_VERSION` env var.
VITE_APP_NAME=ORRBIT
VITE_APP_URL=https://www.orrbit.co.za/
VITE_APP_VERSION=0.1.0

# Reverse-DNS id (macOS CFBundleIdentifier / Windows AppUserModelID). Do not use com.electron.*
VITE_APP_ID=za.co.orrbit.desktop

# Signed-out onboarding carousel (four slides). Blank values use in-app fallbacks that include VITE_APP_NAME.
VITE_ONBOARDING_1_TITLE=Welcome to ORRBIT
VITE_ONBOARDING_1_BODY=Sign in once and pick up ORRBIT on this desktop.
VITE_ONBOARDING_2_TITLE=Built for your desk
VITE_ONBOARDING_2_BODY=A native window with the same ORRBIT account you already use.
VITE_ONBOARDING_3_TITLE=Your workspace
VITE_ONBOARDING_3_BODY=Theme, language, and updates stay with this app on your machine.
VITE_ONBOARDING_4_TITLE=What's new
VITE_ONBOARDING_4_BODY=This build of ORRBIT is ready. Open it to see the latest changes.
