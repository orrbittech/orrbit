# Same Clerk application as web/ and apk/. Publishable key only — never put CLERK_SECRET_KEY here.
# Packaged builds load orrbit://renderer — add that origin on this Clerk instance (see README).
VITE_CLERK_PUBLISHABLE_KEY=

# Product identity used for the window title, dock/installer name, bundle id, and About.
# Same pattern as the APK `EXPO_PUBLIC_APP_VERSION` env var.
VITE_APP_NAME=ORRBIT
VITE_APP_URL=https://www.orrbit.co.za/
VITE_APP_VERSION=0.1.0

# Reverse-DNS id (macOS CFBundleIdentifier / Windows AppUserModelID). Do not use com.electron.*
VITE_APP_ID=za.co.orrbit.desktop
