{
  "name": "orrbit",
  "productName": "ORRBIT",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "ORRBIT",
  "author": "Orrbit Technologies",
  "homepage": "https://www.orrbit.co.za/",
  "main": "./out/main/index.js",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "yarn typecheck && electron-vite build",
    "build:mac": "yarn build && electron-builder --mac --config electron-builder.config.cjs",
    "build:win": "yarn build && electron-builder --win --config electron-builder.config.cjs",
    "build:all": "yarn build && electron-builder --mac --win --config electron-builder.config.cjs",
    "build:unpack": "yarn build && electron-builder --dir --config electron-builder.config.cjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@clerk/react": "^6.14.4",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.564.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.9.4",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.2.6"
  }
}
